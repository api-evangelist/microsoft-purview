{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/DlpMatchedRule",
  "title": "DlpMatchedRule",
  "type": "object",
  "properties": {
    "ruleId": {
      "type": "string"
    },
    "ruleName": {
      "type": "string"
    },
    "policyId": {
      "type": "string"
    },
    "policyName": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/components/schemas/DlpAction"
      }
    }
  }
}