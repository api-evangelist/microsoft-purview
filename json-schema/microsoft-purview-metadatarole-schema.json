        },
        "friendlyName": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "cnfCondition": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AttributeMatcher"
            }
          }
        }
      }
    }
  }
