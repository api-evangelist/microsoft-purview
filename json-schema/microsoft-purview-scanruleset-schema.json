{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/ScanRuleset",
  "title": "ScanRuleset",
  "type": "object",
  "description": "A scan ruleset configuration",
  "properties": {
    "id": {
      "type": "string",
      "readOnly": true
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "properties": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "includedCustomClassificationRuleNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastModifiedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}